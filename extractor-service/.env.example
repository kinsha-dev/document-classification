# Server
PORT=3100
HOST=0.0.0.0

# File upload limits
MAX_FILE_SIZE_MB=50

# Output directory (where JSON results are written)
OUTPUT_DIR=./output

# Tesseract OCR language(s) — comma-separated, e.g. eng,fra
TESSERACT_LANG=eng

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ─── LM Studio (local AI classification, OpenAI-compatible API) ──
# Where the LM Studio server is reachable from this Node process.
# LM Studio binds to http://127.0.0.1:1234 by default; the /v1 suffix
# is required by the OpenAI-compatible API. (The service auto-appends
# /v1 if you omit it.) Use 127.0.0.1 over localhost to avoid IPv6/DNS
# quirks on some macOS setups.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Default model id — must match the "API Model Identifier" shown in
# LM Studio's right-hand panel for the loaded model. Examples:
#   gemma-4-e2b-it:2                   # what LM Studio shows when you load Gemma 4 E2B
#   google/gemma-3-4b-it
#   lmstudio-community/gemma-3-4b-it-GGUF
# If the configured model isn't loaded, the service falls back to the
# first model returned by /v1/models so things still work.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it

# Path to the classification prompt template (skill.md).
# Leave unset to auto-discover (workspace folder, then sibling of this service).
CLASSIFY_PROMPT_FILE=../skill.md

# ─── Metadata search ─────────────────────────────────────────
# Approved search metadata + search patterns. Leave unset to auto-discover
# metadata-schema.json in the workspace folder.
METADATA_SCHEMA_FILE=../metadata-schema.json

# Optional: embedding model on OpenRouter for dense semantic search ranking
# (e.g. openai/text-embedding-3-small). Leave empty for keyword (BM25) only.
EMBEDDING_MODEL=openai/text-embedding-3-small
